# Copy this file to .env.local (local dev) or add these in Vercel > Project > Settings > Environment Variables.
# Get free Alpaca paper keys at https://alpaca.markets (Paper Trading > API Keys).
# Binance crypto prices need NO key.
VITE_ALPACA_KEY=your_alpaca_key_id_here
VITE_ALPACA_SECRET=your_alpaca_secret_here
